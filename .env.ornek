# Yerel geliştirme için örnek ortam değişkenleri. `cp .env.ornek .env` ile kopyalayın.
# Buradaki değerler yalnız yerel kapsayıcılar içindir; gerçek anahtar ya da parola bu dosyaya yazılmaz.

# PostgreSQL 17 + pgvector (infra/gelistirme/docker-compose.yml)
POSTGRES_USER=akredit
POSTGRES_PASSWORD=yerel-gelistirme
POSTGRES_DB=akredit
POSTGRES_PORT=5432
DATABASE_URL=postgres://akredit:yerel-gelistirme@localhost:5432/akredit

# MinIO (S3 uyumlu kanıt deposu)
S3_UC_NOKTASI=http://localhost:9000
S3_BOLGE=us-east-1
S3_KOVA=akredit-kanit
S3_ERISIM_ANAHTARI=akredit
S3_GIZLI_ANAHTAR=yerel-gelistirme
S3_PORT=9000
S3_KONSOL_PORT=9001

# Mailpit (gönderilen e-postalar http://localhost:8025 adresinde görünür)
SMTP_ADRESI=smtp://localhost:1025
SMTP_PORT=1025
POSTA_ARAYUZ_PORT=8025

# Web
NEXT_TELEMETRY_DISABLED=1

# Kurumların yapay zekâ anahtarlarını (BYOK) şifreleyen ana anahtar: 32 bayt, base64.
# Üret: openssl rand -base64 32. Yoksa anahtar kaydı açık bir hatayla reddedilir.
AKREDIT_ANAHTAR_KASASI=
