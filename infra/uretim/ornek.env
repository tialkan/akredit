# Üretim/hazırlık ortam değişkenleri ÖRNEĞİ. Gerçek değerler bu dosyaya yazılmaz.
# Gerçek değerler `sirlar/<ortam>.sops.env` içinde age ile şifreli tutulur ve
# `infra/uretim/sirlar-ac.sh <ortam>` ile sunucuda /run/akredit/<ortam>.env'e (tmpfs, 0600) açılır.
# Bkz. docs/isletim/sirlar.md

# Ortam: uretim | hazirlik
AKREDIT_ORTAM=uretim
# Dağıtılan sürüm (git etiketi, örn. v0.3.0; hazırlıkta ana-<kısa-sha>). dagit.sh yazar.
AKREDIT_SURUM=
# Kayıt defterindeki imaj adları (sürüm eklenmeden)
WEB_IMAJ_ADI=ghcr.io/SAHIP/akredit-web
ISCI_IMAJ_ADI=ghcr.io/SAHIP/akredit-isci

# Alan adları
AKREDIT_ALAN=akredit.org
AKREDIT_UYGULAMA_ALAN=uygulama.akredit.org
AKREDIT_BELGE_ALAN=belgeler.akredit.org
AKREDIT_DURUM_ALAN=durum.akredit.org
ACME_EPOSTA=

# Uygulama
AKREDIT_ADRES=https://uygulama.akredit.org
AKREDIT_ONAY_GIZLI=
AKREDIT_ANKET_GIZLI=

# PostgreSQL
POSTGRES_USER=akredit
POSTGRES_PASSWORD=
POSTGRES_DB=akredit
# Çoğaltma/yedek kullanıcısı (REPLICATION yetkili; kurulum.md 5. adım)
YEDEK_KULLANICI=akredit_yedek
YEDEK_PAROLA=
YEDEK_SAKLA_GUN=35
# Web/işçi ve gözlem kullanıcıları: süper kullanıcı değil (İP-27; postgres/02-uygulama-kullanicilari.sh)
UYGULAMA_VT_KULLANICI=akredit_uyg
UYGULAMA_VT_PAROLA=
IZLEME_VT_KULLANICI=akredit_izleme
IZLEME_VT_PAROLA=

# Site dışı yedek: rclone uzak tanımı (Türkiye'de ikinci bölge/sağlayıcı, sürümleme + nesne kilidi açık)
RCLONE_CONFIG_UZAK_TYPE=s3
RCLONE_CONFIG_UZAK_PROVIDER=Other
RCLONE_CONFIG_UZAK_ENDPOINT=
RCLONE_CONFIG_UZAK_ACCESS_KEY_ID=
RCLONE_CONFIG_UZAK_SECRET_ACCESS_KEY=
YEDEK_UZAK_KOVA=akredit-yedek

# Kanıt nesne deposu (sürümleme + nesne kilidi açık kova)
S3_UC_NOKTASI=
S3_BOLGE=
S3_KOVA=akredit-kanit
S3_ERISIM_ANAHTARI=
S3_GIZLI_ANAHTAR=

# E-posta (SPF/DKIM/DMARC için docs/isletim/alan-adi-ve-tls.md)
SMTP_ADRESI=

# Uyarılar (Alertmanager ve Gatus aynı SMTP'yi kullanır)
UYARI_EPOSTA=
UYARI_SMTP_SUNUCU=
UYARI_SMTP_KULLANICI=
UYARI_SMTP_PAROLA=

# Kurumların yapay zekâ anahtarlarını (BYOK) şifreleyen ana anahtar: 32 bayt, base64.
# Üret: openssl rand -base64 32. Yoksa anahtar kaydı açık bir hatayla reddedilir.
AKREDIT_ANAHTAR_KASASI=
