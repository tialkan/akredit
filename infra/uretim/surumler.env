# Üretim ve hazırlık imaj sürümleri. `latest` YASAKTIR (infra/uretim/denetle.sh reddeder).
# Her imaj sürüm etiketiyle yazılır; ilk kurulumda `infra/uretim/imaj-sabitle.sh` bu etiketleri
# kayıt defterinden içerik özetine (@sha256:...) çözer ve bu dosyayı günceller.
# NOT: Bu ortamda kayıt defterine erişim yoktu; aşağıdaki etiketlerin varlığı DOĞRULANMADI.
# imaj-sabitle.sh bulunamayan etiket için hata verir; o zaman güncel kararlı sürümü yazın.

CADDY_IMAJI=caddy:2.8.4-alpine
VT_IMAJI=pgvector/pgvector:0.8.0-pg17
RCLONE_IMAJI=rclone/rclone:1.68.2
GATUS_IMAJI=twinproduction/gatus:v5.13.1
OTEL_IMAJI=otel/opentelemetry-collector-contrib:0.111.0
PROMETHEUS_IMAJI=prom/prometheus:v2.55.0
ALERTMANAGER_IMAJI=prom/alertmanager:v0.27.0
NODE_EXPORTER_IMAJI=prom/node-exporter:v1.8.2
PG_EXPORTER_IMAJI=prometheuscommunity/postgres-exporter:v0.15.0
