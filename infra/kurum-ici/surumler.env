# Kurum içi kurulumun imaj sürümleri. `latest` YASAKTIR (denetle.sh reddeder).
# Caddy ve PostgreSQL infra/uretim/surumler.env ile aynı tutulur.
# NOT: Bu dosya yazılırken kayıt defterine erişim yoktu; etiketlerin varlığı DOĞRULANMADI.
# demet-olustur.sh internete açık makinede her imajı çeker (bulunamayan etikette durur) ve
# içerik özetlerini demetin imajlar.txt dosyasına yazar.

CADDY_IMAJI=caddy:2.8.4-alpine
VT_IMAJI=pgvector/pgvector:0.8.0-pg17
MINIO_IMAJI=minio/minio:RELEASE.2024-10-13T13-34-11Z
OLLAMA_IMAJI=ollama/ollama:0.4.7
