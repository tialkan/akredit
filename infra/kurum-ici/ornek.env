# Kurum içi kurulum ortam değişkenleri ÖRNEĞİ. Gerçek değerler /etc/akredit/akredit.env dosyasına
# (sahibi root, izin 0600) yazılır; bu dosyaya yazılmaz. Gizli değer üretmek için: openssl rand -hex 32

# Kurulu Akredit sürümü (demetteki imaj etiketi, örn. v0.3.0). kur.sh / yukselt.sh günceller.
AKREDIT_SURUM=
# Demetten yüklenen imaj adları (sürüm eklenmeden)
WEB_IMAJ_ADI=ghcr.io/SAHIP/akredit-web
ISCI_IMAJ_ADI=ghcr.io/SAHIP/akredit-isci

# Kurum içi alan adı (iç DNS) ve sertifika dizini (akredit.crt + akredit.key)
AKREDIT_UYGULAMA_ALAN=akredit.kurum.example
AKREDIT_SERTIFIKA_DIZINI=/etc/akredit/sertifika
AKREDIT_HTTPS_PORT=443
AKREDIT_HTTP_PORT=80

# Gizli değerler (boş bırakılanları kur.sh üretir)
AKREDIT_ONAY_GIZLI=
AKREDIT_ANKET_GIZLI=
AKREDIT_TAKMA_AD_ANAHTARI=

# PostgreSQL
POSTGRES_USER=akredit
POSTGRES_PASSWORD=
POSTGRES_DB=akredit
# Web ve işçinin bağlandığı ayrıcalıksız kullanıcı (süper kullanıcı değil; POSTGRES_USER'dan farklı olmalı).
# Parola boş bırakılırsa kur.sh üretir.
UYGULAMA_VT_KULLANICI=akredit_uyg
UYGULAMA_VT_PAROLA=
# Yükseltme öncesi yedeklerin yazıldığı dizin; kurumun yedek sistemine de alınmalıdır.
AKREDIT_YEDEK_DIZINI=/var/lib/akredit/yedekler

# Kanıt nesne deposu: kurumun S3 uyumlu deposu ya da "depo" profiliyle yerel MinIO (http://depo:9000)
S3_UC_NOKTASI=http://depo:9000
S3_BOLGE=yerel
S3_KOVA=akredit-kanit
S3_ERISIM_ANAHTARI=
S3_GIZLI_ANAHTAR=

# Kurum içi e-posta aktarıcısı (isteğe bağlı)
SMTP_ADRESI=

# Yapay zekâ: yalnız yerel model.
#   ollama: AKREDIT_YZ_ADRES=http://model:11434/v1   AKREDIT_YZ_MODEL=qwen2.5:14b
#   vllm  : AKREDIT_YZ_ADRES=http://model:8000/v1    AKREDIT_YZ_MODEL=<modeller dizinindeki klasör adı>
AKREDIT_YZ_HAZIR=ollama
AKREDIT_YZ_ADRES=http://model:11434/v1
AKREDIT_YZ_MODEL=qwen2.5:14b
AKREDIT_MODEL_DIZINI=/var/lib/akredit/modeller

# Açılacak profiller: model sunucusu (ollama | vllm) ve isteğe bağlı yerel nesne deposu (depo)
AKREDIT_PROFILLER=ollama depo
